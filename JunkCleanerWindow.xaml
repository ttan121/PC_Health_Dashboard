<Window x:Class="PCHealthDashboard.JunkCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealthDashboard.ViewModels"
        Title="Dọn Rác Hệ Thống" Height="500" Width="600"
        Background="{StaticResource SurfacePrimary}" Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    
    <Window.DataContext>
        <vm:JunkCleanerViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="System Junk Cleaner" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
        <TextBlock Text="Select drives to scan for temporary files and other junk." 
                   Grid.Row="1" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,15"/>
        
        <Border Grid.Row="2" Background="{StaticResource SurfaceSecondary}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        
        <Border Grid.Row="3" Background="{StaticResource SurfaceSecondary}" CornerRadius="6" Padding="2" Margin="0,0,0,10">
            <ListView ItemsSource="{Binding JunkFiles}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SurfaceSecondary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File" Width="350">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeStr}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TotalJunkSize, StringFormat=Total: {0}}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" Content="Hủy" Click="CancelButton_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Grid.Column="2" Content="Quét Rác" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" Background="{StaticResource SurfaceSecondary}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderNeutral}" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Grid.Column="3" Content="Dọn Dẹp Ngay" Command="{Binding CleanCommand}" IsEnabled="{Binding CanClean}" Background="{StaticResource SemanticInfo}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="15,8" Cursor="Hand" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
