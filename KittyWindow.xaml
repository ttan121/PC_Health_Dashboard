<Window x:Class="PCHealthDashboard.KittyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCHealthDashboard"
        Title="PC Health Popup" Width="300" MinHeight="260" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="8" CaptionHeight="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource SurfacePrimary}" BorderBrush="{StaticResource BorderNeutral}" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SemanticHealthy}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HealthScoreText" Text="92 Healthy" Style="{StaticResource TextMetricValue}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Content="📌" FontSize="11" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Padding="5,1" Cursor="Hand" Click="PinButton_Click" ToolTip="Ghim/Bá» ghim"/>
                    <Button Content="✕" FontSize="12" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Padding="5,1" Cursor="Hand" Click="ClosePopup_Click"/>
                </StackPanel>
            </Grid>

            <!-- METRICS LIST -->
            <StackPanel Grid.Row="1">
                <!-- CPU -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CpuText" Text="42%" Style="{StaticResource TextBody}"/>
                        <TextBlock x:Name="CpuTempText" Text=" 45°C" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" Height="4" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" x:Name="CpuFill" />
                                <ColumnDefinition Width="*" x:Name="CpuEmpty" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SemanticInfo}" CornerRadius="2"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- RAM -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RamText" Grid.Column="1" Text="61%" Style="{StaticResource TextBody}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="2" Height="4" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" x:Name="RamFill" />
                                <ColumnDefinition Width="*" x:Name="RamEmpty" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SemanticHealthy}" CornerRadius="2"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- GPU -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU" Style="{StaticResource TextLabel}" VerticalAlignment="Top"/>
                    
                    <ItemsControl x:Name="GpuItemsControl" Grid.Column="1" Grid.ColumnSpan="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Usage, StringFormat={}{0:F0}%}" Style="{StaticResource TextBody}"/>
                                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:F0}°C}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="70" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    
                                    <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                                        <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                                        <ProgressBar Value="{Binding Usage}" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="#a855f7"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemsSource.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <TextBlock Text="N/A" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </Grid>

                <!-- SSD -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SSD" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SsdText" Grid.Column="1" Text="72%" Style="{StaticResource TextBody}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="2" Height="4" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" x:Name="SsdFill" />
                                <ColumnDefinition Width="*" x:Name="SsdEmpty" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SemanticWarning}" CornerRadius="2"/>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- NETWORK -->
            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="NETWORK" Style="{StaticResource TextLabel}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="↓" Foreground="{StaticResource SemanticInfo}" Style="{StaticResource TextBody}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="NetDownText" Text="0.0" Style="{StaticResource TextBody}" Margin="0,0,8,0"/>
                        <TextBlock Text="↑" Foreground="#a855f7" Style="{StaticResource TextBody}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="NetUpText" Text="0.0" Style="{StaticResource TextBody}"/>
                    </StackPanel>
                </Grid>
                <!-- Sparkline -->
                <Border Height="32" Background="{StaticResource SurfaceSecondary}" CornerRadius="4" Padding="2">
                    <Polyline x:Name="NetworkSparkline" Stroke="{StaticResource SemanticInfo}" StrokeThickness="1.5" Stretch="Fill" />
                </Border>
            </StackPanel>

            <!-- ALERTS -->
            <ItemsControl Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding SystemAlerts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToColorConverter}, ConverterParameter=bg}" 
                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" 
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</Window>

