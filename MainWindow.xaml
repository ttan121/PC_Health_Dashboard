<Window x:Class="PCHealthDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealthDashboard.ViewModels"
        xmlns:controls="clr-namespace:PCHealthDashboard.Views.Controls"
        Title="PC Health Dashboard" SizeToContent="Height" MinHeight="480" MinWidth="760" Width="760" ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" Background="#0a0c10"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Subtle Bongo Cat / Icon -->
                    <Border Width="24" Height="24" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="4" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding HealthStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding HealthStatus}" Style="{StaticResource TextLabel}" Foreground="{Binding HealthStatusColor}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- OSD Color Picker -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="OSD:" Style="{StaticResource TextLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <RadioButton GroupName="OsdColor" Content=" " Background="#fde047" BorderThickness="0" Margin="0,0,4,0" IsChecked="{Binding OsdColor, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Yellow}"/>
                        <RadioButton GroupName="OsdColor" Content=" " Background="#fb923c" BorderThickness="0" Margin="0,0,4,0" IsChecked="{Binding OsdColor, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Orange}"/>
                        <RadioButton GroupName="OsdColor" Content=" " Background="#f87171" BorderThickness="0" Margin="0,0,4,0" IsChecked="{Binding OsdColor, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Red}"/>
                        <RadioButton GroupName="OsdColor" Content=" " Background="#4ade80" BorderThickness="0" IsChecked="{Binding OsdColor, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Green}"/>
                    </StackPanel>
                    <Button Content="Widget" Foreground="{StaticResource TextSecondary}" Background="{StaticResource SurfaceSecondary}" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="CustomizeButton_Click" ToolTip="Mở Popup Lớn"/>
                    <Button Content="Mini" Foreground="{StaticResource TextSecondary}" Background="{StaticResource SurfaceSecondary}" BorderThickness="0" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" Click="CompactWidgetButton_Click" ToolTip="Mở Popup Nhỏ (Compact)"/>
                </StackPanel>
            </Grid>

            <!-- HEALTH OVERVIEW & ALERTS -->
            <Grid Grid.Row="1" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- HEALTH OVERVIEW -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0" VerticalAlignment="Bottom">
                    <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding HealthScore}" Style="{StaticResource TextDisplay}"/>
                        <TextBlock Text="/ 100" Style="{StaticResource TextMetricValue}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- ALERTS -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="120" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding SystemAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToColorConverter}, ConverterParameter=bg}" 
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" 
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Metric}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource TextMuted}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

                        <!-- METRICS GRID -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">
                    <!-- CPU -->
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CPU" Style="{StaticResource TextLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" Style="{StaticResource TextMetricValue}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Progress Bar -->
                        <Grid Height="4">
                            <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding CpuUsage}" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SemanticInfo}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding CpuTemperatureDisplay}" ToolTip="{Binding CpuTemperatureTooltip}" Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CpuTemperatureStatus}" Foreground="{StaticResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- RAM -->
                    <StackPanel Margin="0,32,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="MEMORY" Style="{StaticResource TextLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RamUsed, StringFormat={}{0:F1} GB}" Style="{StaticResource TextMetricValue}"/>
                                <TextBlock Text="{Binding RamTotal, StringFormat= / {0:F0} GB}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Height="4">
                            <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                            <ProgressBar Value="{Binding RamUsed}" Maximum="{Binding RamTotal}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SemanticHealthy}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="⚡ Dọn RAM" Command="{Binding CleanRamCommand}" 
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" 
                                    FontSize="11" Padding="0" Margin="0,0,16,0" Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SemanticHealthy}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="⚙ Tùy chọn Tối ưu..." Command="{Binding OpenRamOptimizerCommand}" 
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" 
                                    FontSize="11" Padding="0" Margin="0,0,16,0" Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SemanticInfo}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="🧹 Dọn Rác Hệ Thống" Command="{Binding CleanJunkCommand}" 
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" 
                                    FontSize="11" Padding="0" Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SemanticWarning}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Text="{Binding RamCleanStatus}" Foreground="{StaticResource SemanticHealthy}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- RUNNING PROCESSES -->
                    <StackPanel Margin="0,24,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource TextLabel}"/>
                            <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="28" Margin="0,0,0,6">
                            <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="7,3"
                                     Background="{StaticResource SurfaceSecondary}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderNeutral}"
                                     ToolTip="Tìm theo tên tiến trình hoặc PID"/>
                            <TextBlock Text="⌕  Tìm theo tên tiến trình hoặc PID" Style="{StaticResource TextLabel}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding IsProcessFilterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="6" Padding="4">
                            <DataGrid ItemsSource="{Binding ProcessEntriesView}" Height="185" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0"
                                      Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource SurfacePrimary}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderNeutral}"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="5,5"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{StaticResource SurfaceSecondary}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1c293a"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#263b82f6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                    <Style x:Key="ProcessGridTextStyle" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                    <Style x:Key="ProcessNameGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ProcessGridTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding IdentityDisplay}"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process / PID" Binding="{Binding IdentityDisplay}" SortMemberPath="Name" Width="*"
                                                        ElementStyle="{StaticResource ProcessNameGridTextStyle}"/>
                                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" SortMemberPath="CpuPercent" Width="48"
                                                        ElementStyle="{StaticResource ProcessGridTextStyle}"/>
                                    <DataGridTextColumn Header="RAM" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryMegabytes" Width="58"
                                                        ElementStyle="{StaticResource ProcessGridTextStyle}"/>
                                    <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="×" Width="23" Height="23" Padding="0" Background="#20ef4444"
                                                            Foreground="{StaticResource SemanticCritical}" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Kết thúc tác vụ" Visibility="{Binding CanTerminate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.EndProcessCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="—" Style="{StaticResource TextLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               ToolTip="Tiến trình hệ thống hoặc dashboard được bảo vệ"
                                                               Visibility="{Binding CanTerminate, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock Text="Bấm tiêu đề cột để sắp xếp · Đóng tác vụ an toàn, buộc dừng sẽ hỏi xác nhận." Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProcessOperationStatus}" Style="{StaticResource TextLabel}" Foreground="{StaticResource SemanticWarning}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">
                    <!-- GPU -->
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource TextLabel}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,24">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" HorizontalAlignment="Left"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Usage, StringFormat={}{0:F0}%}" Style="{StaticResource TextMetricValue}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="4" Margin="0,0,0,4">
                                            <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                                            <ProgressBar Value="{Binding Usage}" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SemanticInfo}"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding TemperatureDisplay}" Style="{StaticResource TextBody}" HorizontalAlignment="Left"/>
                                            <TextBlock Style="{StaticResource TextLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsVramAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="{Binding IsSharedMemory, Converter={StaticResource SharedVramPrefixConverter}, FallbackValue=VRAM}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding VramUsed, StringFormat={}{0:F1}}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding VramTotal, StringFormat={}{0:F0}}"/>
                                                <Run Text=" GB"/>
                                            </TextBlock>
                                            <TextBlock Text="N/A" Style="{StaticResource TextLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Visibility="{Binding IsVramAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Gpus.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock Text="No compatible GPU telemetry available" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </StackPanel>

                    <!-- STORAGE -->
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="SYSTEM VOLUME" Style="{StaticResource TextLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SystemDriveLabel}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SsdUsedSpace, StringFormat={}{0:F0} GB}" Style="{StaticResource TextMetricValue}"/>
                                <TextBlock Text="{Binding SsdTotalSpace, StringFormat= / {0:F0} GB}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Height="4">
                            <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="2" />
                            <ProgressBar Value="{Binding SsdUsedSpace}" Maximum="{Binding SsdTotalSpace}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource SemanticWarning}"/>
                        </Grid>
                        <TextBlock Text="{Binding StorageWearSummary}" Style="{StaticResource TextBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StorageHealthStatus}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding StorageDrives}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceSecondary}" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DeviceIdDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DriveTypeDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DeviceHealthDisplay}" Style="{StaticResource TextLabel}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding WearDisplay}" Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AvailableSpareDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding TemperatureDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding PowerOnHoursDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding NvmeErrorCountersDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UncorrectedErrorsDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding CriticalWarningDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding ReliabilitySourceDisplay}" Style="{StaticResource TextLabel}" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- NETWORK -->
            <StackPanel Grid.Row="3" Margin="0,32,0,0">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="NETWORK" Style="{StaticResource TextLabel}"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PingLatency, StringFormat=Ping {0}ms}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding PacketLoss, StringFormat=Loss {0:F1}%}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                        
                        <TextBlock Text="↓" Foreground="{StaticResource SemanticInfo}" Style="{StaticResource TextBody}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DownloadMbps, StringFormat={}{0:F1} Mbps}" Style="{StaticResource TextMetricValue}" Margin="0,0,16,0"/>
                        <TextBlock Text="↑" Foreground="#a855f7" Style="{StaticResource TextBody}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding UploadMbps, StringFormat={}{0:F1} Mbps}" Style="{StaticResource TextMetricValue}"/>
                    </StackPanel>
                </Grid>
                <!-- High-Performance Zero-Allocation SkiaSharp Sparkline -->
                <Border Height="44" Background="{StaticResource SurfaceSecondary}" CornerRadius="6" Padding="4" ClipToBounds="True">
                    <controls:SkiaSparklineControl x:Name="NetworkSparkline" 
                                                  PrimaryColor="#3b82f6" 
                                                  SecondaryColor="#a855f7" 
                                                  IsDualChannel="True" 
                                                  AutoScale="True" 
                                                  SmoothCurves="True" 
                                                  StrokeThickness="2" />
                </Border>
            </StackPanel>


        </Grid>
</Window>


